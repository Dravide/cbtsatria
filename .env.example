APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8781

# Zona waktu SELURUH penjadwalan ujian - jendela sesi, validitas token, tautan
# pintu ruang, dan `now()` yang membandingkannya. Diisi zona sekolah; satu
# nilai berlaku untuk seluruh pemasangan, sehingga sekolah WITA/WIT harus
# mengubahnya ke zona masing-masing. Lihat catatan panjangnya di
# `config/app.php`, termasuk apa yang harus dikerjakan lebih dulu bila kelak
# ada sekolah di luar WIB.
APP_TIMEZONE=Asia/Jakarta

# Lihat catatan di .env: `php artisan serve` membaca SERVER_PORT, bukan
# APP_PORT. Tanpa ini dev server memakai 8000 dan bisa bertabrakan dengan
# proyek lain di mesin yang sama.
SERVER_PORT=8781

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=cbt_satria
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Aplikasi ini TIDAK memakai SSR (tidak ada `resources/js/ssr.tsx`, tidak ada
# skrip `build:ssr` di package.json, dan tidak ada `bootstrap/ssr/`). Baris ini
# menyatakannya secara tegas, dan itu perlu karena bawaan paket Inertia adalah
# `true`.
#
# Selama `public/hot` ada, `Vite::isRunningHot()` mengembalikan true - dan
# `Inertia\Ssr\HttpGateway` membaca itu sebagai "SSR berjalan di dev server
# Vite", lalu mengirim SETIAP halaman sebagai POST ke
# `{VITE_URL}/__inertia_ssr`. Endpoint itu tidak ada, jadi permintaannya
# menunggu sampai timeout sebelum jatuh kembali ke render sisi klien.
#
# Harganya ~1,4 detik per halaman Inertia, yaitu pada SETIAP pemuatan halaman
# selama pengembangan. Di produksi `public/hot` tidak ada sehingga tidak
# terasa - dan justru itu yang membuatnya lama tidak ketahuan.
INERTIA_SSR_ENABLED=false
